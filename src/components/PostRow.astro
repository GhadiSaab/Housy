---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
---
<article class="post-row">
  <div>
    <time class="eyebrow" datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
    <h3><a href={`/writing/${post.id}/`}>{post.data.title}<span aria-hidden="true">↗</span></a></h3>
    <p>{post.data.description}</p>
    {post.data.tags.length > 0 && <ul class="tags" aria-label="Tags">{post.data.tags.map(tag => <li>{tag}</li>)}</ul>}
  </div>
</article>
