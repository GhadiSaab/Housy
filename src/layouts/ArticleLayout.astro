---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/content';
interface Props {
  title: string; description: string; publishedAt?: Date; updatedAt?: Date;
  tags?: string[]; kind?: 'project' | 'post';
}
const { title, description, publishedAt, updatedAt, tags = [], kind = 'post' } = Astro.props;
const back = kind === 'project' ? { href: '/projects/', label: 'All projects' } : { href: '/writing/', label: 'All field notes' };
---
<BaseLayout title={`${title} — Ghadi`} description={description}>
  <article class="article-wrap">
    <a class="back-link eyebrow" href={back.href}><span aria-hidden="true">←</span> {back.label}</a>
    <header class="article-header">
      <p class="eyebrow">{kind === 'project' ? 'PROJECT NOTES' : 'FIELD NOTES'}{publishedAt && <> / <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time></>}</p>
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      {tags.length > 0 && <ul class="tags" aria-label={kind === 'project' ? 'Technologies' : 'Tags'}>{tags.map(tag => <li>{tag}</li>)}</ul>}
      {updatedAt && <p class="updated-note">Updated <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></p>}
    </header>
    <div class="prose"><slot /></div>
    <div class="article-end"><span aria-hidden="true">✳</span><a href={back.href}>Back to {kind === 'project' ? 'projects' : 'field notes'} <span aria-hidden="true">↗</span></a></div>
  </article>
</BaseLayout>
